# copy to .env.local and fill your keys
NVIDIA_API_KEY=nvapi-xxxx
# default cloud endpoint, change only for local NIM
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# live sharing rooms, needs a secret from the liveblocks.io dashboard (optional)
LIVEBLOCKS_SECRET_KEY=sk-xxxx
# flip to true after adding the secret above, then restart
NEXT_PUBLIC_LIVE_ENABLED=true
